{
  "name": "@catbyte/ui",
  "version": "0.3.0",
  "description": "Sistema de diseño de CatByte: tokens y componentes React sincronizados con Figma.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tema.css": "./dist/tema.css",
    "./marca/*": "./marca/*"
  },
  "files": [
    "dist",
    "marca",
    "tokens"
  ],
  "scripts": {
    "tokens": "node scripts/generar-tokens.mjs",
    "build": "npm run tokens && tsc -p tsconfig.build.json && node scripts/copiar-css.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.4"
  }
}
